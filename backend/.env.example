# KiranaGo Backend Environment Variables

# --- Server ---
PORT=3000

# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kiranago

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# --- Store Settings ---
SHOPKEEPER_PHONE=+919876543210